# Development defaults to apps/api/var/mercator.db when this variable is absent.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/mercator
# AUTH_DATABASE_URL=postgresql+psycopg://identity_role:password@127.0.0.1:5432/mercator
# AUTO_MIGRATE=false
# SEED_DEMO_DATA=false

# Authentication: production requires an approved OIDC adapter and injected secrets.
# Local login uses the same account/password API as production. These defaults
# are accepted only by the non-production identity adapter.
# LOCAL_LOGIN_ACCOUNT=owner
# LOCAL_LOGIN_EMAIL=owner@local.aitradecloud.invalid
# LOCAL_LOGIN_PASSWORD=zhimaoyun123
# LOCAL_LOGIN_PHONE=13800138000
# APP_ENV=production
# AUTH_PROFILE=enterprise_oidc
# LOCAL_FAKE_REDIRECT_HOSTS=100.64.0.1,dev-machine.example-tailnet.ts.net
# OIDC_ISSUER=https://identity.example.com/application/o/ai-trade-cloud/
# OIDC_CLIENT_ID=ai-trade-cloud-web
# OIDC_CLIENT_SECRET=inject-through-your-secret-manager
# KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
# The confidential client service account needs realm-management/manage-users
# to create restricted customer-portal subaccounts and reset their passwords.
# OIDC_REDIRECT_URIS=https://your-domain.example/login/callback
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_ALGORITHMS=RS256,ES256
# OIDC_ALLOWED_ENDPOINT_HOSTS=identity.example.com
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# OIDC_HTTP_TIMEOUT_SECONDS=10
# PUBLIC_BASE_URL=https://your-domain.example
# OIDC_POST_LOGOUT_REDIRECT_URI=https://your-domain.example/login
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# EMBEDDING_SETTINGS_MASTER_KEY=replace-with-at-least-32-random-characters
# TRANSLATION_SETTINGS_MASTER_KEY=replace-with-at-least-32-random-characters
# SUPPORT_AI_SETTINGS_MASTER_KEY=replace-with-at-least-32-random-characters
# AUTH_ACCESS_TTL_SECONDS=600
# AUTH_SESSION_TTL_SECONDS=604800
# AUTH_REFRESH_TTL_SECONDS=604800
# AUTH_REFRESH_RETRY_GRACE_SECONDS=5
# AUTH_PERMISSION_CACHE_TTL_SECONDS=15
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# QUERY_CACHE_ENABLED=true
# QUERY_CACHE_DASHBOARD_TTL_SECONDS=30
# QUERY_CACHE_CATALOG_TTL_SECONDS=30
# QUERY_CACHE_INVENTORY_TTL_SECONDS=20
# QUERY_CACHE_METADATA_TTL_SECONDS=300
# AUTH_TEST_BYPASS must never be enabled outside APP_ENV=test.

# Text Embedding. Production should use an approved OpenAI-compatible
# /v1/embeddings provider and inject the API key through the secret store.
# TEXT_EMBEDDING_PROFILE=openai_compatible
# TEXT_EMBEDDING_API_KEY=inject-through-your-secret-manager
# TEXT_EMBEDDING_BASE_URL=https://api.example.com
# TEXT_EMBEDDING_MODEL=text-embedding-3-large
# TEXT_EMBEDDING_MODEL_VERSION=1-d1024
# TEXT_EMBEDDING_DIMENSIONS=1024
# TEXT_EMBEDDING_TIMEOUT_SECONDS=20
# TEXT_EMBEDDING_PROVIDER_RETRIES=3
# TEXT_EMBEDDING_RETRY_BASE_SECONDS=1

# AI customer-support generation. The Configuration Center stores an encrypted
# database override; these values remain a deployment-level fallback.
# SUPPORT_AI_ENABLED=true
# SUPPORT_AI_BASE_URL=https://api.example.com
# SUPPORT_AI_API_KEY=inject-through-your-secret-manager
# SUPPORT_AI_MODEL=customer-support-model
# SUPPORT_AI_MODEL_DISPLAY_NAME=Professional Support AI
# SUPPORT_AI_TIMEOUT_SECONDS=45
# SUPPORT_AI_MAX_OUTPUT_TOKENS=2048
# SUPPORT_AI_TEMPERATURE=0.1
# SUPPORT_AI_WORKER_INLINE=true
# SUPPORT_AI_STALE_JOB_SECONDS=900

# Storefront catalog translation. Public pages translate on demand, reuse
# field-level PostgreSQL translation memory, and optionally use Redis as a
# short-lived hot cache. Choose exactly one provider profile.
# CATALOG_TRANSLATION_PROFILE=deeplx
# Keep the full DeepLX endpoint in a secret store because some deployments
# include the access token in the URL path.
# DEEPLX_TRANSLATE_URL=https://api.deeplx.example/secret/translate
# DEEPLX_TIMEOUT_SECONDS=20
# Or use an OpenAI-compatible /v1/chat/completions provider. Keep its key only
# in the deployment secret store; reasoning models need a generous output cap
# because reasoning tokens and final translated content share the same budget.
# CATALOG_TRANSLATION_PROFILE=openai_compatible
# OPENAI_TRANSLATION_BASE_URL=https://api.example.com
# OPENAI_TRANSLATION_API_KEY=inject-through-your-secret-manager
# OPENAI_TRANSLATION_MODEL=fast-translation-model
# OPENAI_TRANSLATION_TIMEOUT_SECONDS=20
# OPENAI_TRANSLATION_MAX_TOKENS=16384
# OPENAI_TRANSLATION_REASONING_EFFORT=low
# Or use Alibaba Cloud Machine Translation General Edition. Prefer a RAM user
# whose policy only grants alimt:TranslateGeneral and alimt:GetBatchTranslate.
# CATALOG_TRANSLATION_PROFILE=aliyun_alimt
# ALIYUN_TRANSLATION_ACCESS_KEY_ID=inject-through-your-secret-manager
# ALIYUN_TRANSLATION_ACCESS_KEY_SECRET=inject-through-your-secret-manager
# ALIYUN_TRANSLATION_REGION_ID=cn-hangzhou
# ALIYUN_TRANSLATION_ENDPOINT=mt.cn-hangzhou.aliyuncs.com
# ALIYUN_TRANSLATION_TIMEOUT_SECONDS=20
# CATALOG_TRANSLATION_BATCH_SIZE=50
# CATALOG_TRANSLATION_BATCH_CHARACTERS=10000
# CATALOG_TRANSLATION_PROVIDER_RETRIES=3
# CATALOG_TRANSLATION_RETRY_BASE_SECONDS=2
# TRANSLATION_REQUESTS_PER_MINUTE=60
# PUBLIC_LIVE_TRANSLATION_BATCH_SIZE=48
# PUBLIC_LIVE_TRANSLATION_BATCH_CHARACTERS=8000
# PUBLIC_LIVE_TRANSLATION_CONCURRENCY=3
# PUBLIC_TRANSLATION_REDIS_TTL_SECONDS=21600
# PUBLIC_TRANSLATION_RETENTION_DAYS=60
# PUBLIC_TRANSLATION_CLEANUP_INTERVAL_SECONDS=3600
# PUBLIC_TRANSLATION_CLEANUP_BATCH_SIZE=500

# Immutable storefront language packages. In production, point this adapter at
# Cloudflare R2 and use a custom public domain with storefront CORS enabled.
# If omitted, the adapter reuses OBJECT_STORAGE_* and AWS credentials below.
# TRANSLATION_PACKAGE_STORAGE_BACKEND=s3
# TRANSLATION_PACKAGE_BUCKET=atc-language-packages
# TRANSLATION_PACKAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# TRANSLATION_PACKAGE_REGION=auto
# TRANSLATION_PACKAGE_ACCESS_KEY_ID=inject-through-your-secret-manager
# TRANSLATION_PACKAGE_SECRET_ACCESS_KEY=inject-through-your-secret-manager
# TRANSLATION_PACKAGE_PUBLIC_BASE_URL=https://language-packages.example.com
# TRANSLATION_PACKAGE_LOCAL_ROOT=./var/language-packages

# Storefront product-detail analytics. Exact normalized IP events are deleted
# after the retention window; non-identifying daily totals remain available.
# STOREFRONT_ANALYTICS_RAW_IP_RETENTION_DAYS=60
# TRUST_CLOUDFLARE_VISITOR_HEADERS=false

# Real PostgreSQL conformance test (use secrets/environment injection outside Git).
# ATC_POSTGRES_OWNER_URL=postgresql+psycopg://atc_owner@127.0.0.1:55432/atc_conformance
# ATC_POSTGRES_APP_URL=postgresql+psycopg://atc_app@127.0.0.1:55432/atc_conformance
# ATC_POSTGRES_AUTH_URL=postgresql+psycopg://atc_auth@127.0.0.1:55432/atc_conformance
# ATC_POSTGRES_WORKER_URL=postgresql+psycopg://atc_worker@127.0.0.1:55432/atc_conformance

# Shared media storage. Point the S3-compatible adapter at Cloudflare R2 in
# production; support floating-action images use this storage as well.
# OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_LOCAL_ROOT=./var/object-storage
# OBJECT_STORAGE_BUCKET=atc-files
# OBJECT_STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_ACCESS_KEY_ID=replace-through-secret-manager
# OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-through-secret-manager
# PUBLIC_MEDIA_BASE_URL=https://resources.example.com
# PRODUCT_IMAGE_MAX_BYTES=20971520
# PRODUCT_IMAGE_MAX_EDGE=2400
# Number of concurrent uploads when an XLSX contains embedded product images.
# Keep this modest for R2/S3 connection pools and small API containers.
# PRODUCT_TEMPLATE_IMAGE_UPLOAD_CONCURRENCY=6
# SKU_EXPORT_MAX_ROWS=100000
# FILE_WORKER_INLINE=true
# FILE_WORKER_MAX_ATTEMPTS=3
# FILE_WORKER_LEASE_SECONDS=120
# WORKER_ID=atc-file-worker-1

# Vision/Image Embedding. The deterministic adapter is development/test only;
# production must register an approved provider and pass the image Golden Set.
# IMAGE_INTELLIGENCE_PROFILE=deterministic
# IMAGE_SEARCH_MAX_BYTES=20971520
# IMAGE_SEARCH_TTL_HOURS=24

# Transactional Outbox Relay. Production must use RabbitMQ and a dedicated
# non-owner/NOBYPASSRLS worker role through DATABASE_URL.
# OUTBOX_PUBLISHER_PROFILE=memory
# RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/%2F
# OUTBOX_EXCHANGE=atc.domain-events
# OUTBOX_RELAY_ID=atc-outbox-relay-1
# OUTBOX_RELAY_LEASE_SECONDS=60
