# Development defaults to apps/api/var/mercator.db when this variable is absent.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/mercator
# AUTH_DATABASE_URL=postgresql+psycopg://identity_role:password@127.0.0.1:5432/mercator
# AUTO_MIGRATE=false
# SEED_DEMO_DATA=false

# Authentication: production requires an approved OIDC adapter and injected secrets.
# APP_ENV=production
# AUTH_PROFILE=enterprise_oidc
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# AUTH_ACCESS_TTL_SECONDS=600
# AUTH_SESSION_TTL_SECONDS=43200
# AUTH_REFRESH_TTL_SECONDS=2592000
# AUTH_TEST_BYPASS must never be enabled outside APP_ENV=test.

# Real PostgreSQL conformance test (use secrets/environment injection outside Git).
# ATC_POSTGRES_OWNER_URL=postgresql+psycopg://atc_owner@127.0.0.1:55432/atc_conformance
# ATC_POSTGRES_APP_URL=postgresql+psycopg://atc_app@127.0.0.1:55432/atc_conformance
# ATC_POSTGRES_AUTH_URL=postgresql+psycopg://atc_auth@127.0.0.1:55432/atc_conformance
# ATC_POSTGRES_WORKER_URL=postgresql+psycopg://atc_worker@127.0.0.1:55432/atc_conformance

# File intake security. Production must use S3-compatible storage and ClamAV.
# OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_LOCAL_ROOT=./var/object-storage
# OBJECT_STORAGE_BUCKET=atc-files
# OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=replace-through-secret-manager
# OBJECT_STORAGE_SECRET_KEY=replace-through-secret-manager
# FILE_SCANNER_PROFILE=development
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=30
# FILE_WORKER_INLINE=true
# FILE_WORKER_MAX_ATTEMPTS=3
# FILE_WORKER_LEASE_SECONDS=120
# WORKER_ID=atc-file-worker-1

# Vision/Image Embedding. The deterministic adapter is development/test only;
# production must register an approved provider and pass the image Golden Set.
# IMAGE_INTELLIGENCE_PROFILE=deterministic
# IMAGE_SEARCH_MAX_BYTES=20971520
# IMAGE_SEARCH_TTL_HOURS=24

# Transactional Outbox Relay. Production must use RabbitMQ and a dedicated
# non-owner/NOBYPASSRLS worker role through DATABASE_URL.
# OUTBOX_PUBLISHER_PROFILE=memory
# RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/%2F
# OUTBOX_EXCHANGE=atc.domain-events
# OUTBOX_RELAY_ID=atc-outbox-relay-1
# OUTBOX_RELAY_LEASE_SECONDS=60
