# Local development only. Never reuse these credentials in staging or production.

# PostgreSQL roles
POSTGRES_ADMIN_PASSWORD=atc-local-postgres-admin
ATC_MIGRATION_DB_PASSWORD=atc-local-migration
ATC_APP_DB_PASSWORD=atc-local-app
ATC_AUTH_DB_PASSWORD=atc-local-auth
ATC_WORKER_DB_PASSWORD=atc-local-worker
ATC_SCHEDULER_DB_PASSWORD=atc-local-scheduler

# Runtime dependencies
REDIS_PASSWORD=atc-local-redis
RABBITMQ_USER=atc_local
RABBITMQ_PASSWORD=atc-local-rabbitmq
MINIO_ROOT_USER=atclocal
MINIO_ROOT_PASSWORD=atc-local-minio-password

# Local account authentication. Managed environments must inject real secrets and OIDC.
AUTH_JWT_SECRET=atc-local-jwt-secret-not-for-staging
AUTH_TOKEN_PEPPER=atc-local-token-pepper-not-for-staging
AUTH_ACCESS_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=604800
AUTH_REFRESH_TTL_SECONDS=604800
# Keep this value stable after saving a model in the admin console.
# If omitted, managed settings use AUTH_TOKEN_PEPPER as the encryption root.
EMBEDDING_SETTINGS_MASTER_KEY=atc-local-embedding-settings-key-not-for-staging
# Keep this stable after saving a translation API key in the admin console.
# If omitted, managed settings use AUTH_TOKEN_PEPPER as the encryption root.
TRANSLATION_SETTINGS_MASTER_KEY=atc-local-translation-settings-key-not-for-staging
# Keep this stable after saving the AI support generation key in Configuration Center.
# If omitted, managed settings use AUTH_TOKEN_PEPPER as the encryption root.
SUPPORT_AI_SETTINGS_MASTER_KEY=atc-local-support-ai-settings-key-not-for-staging
AUTH_PERMISSION_CACHE_TTL_SECONDS=15
LOCAL_LOGIN_ACCOUNT=owner
LOCAL_LOGIN_EMAIL=owner@local.aitradecloud.invalid
LOCAL_LOGIN_PASSWORD=zhimaoyun123
# LOCAL_LOGIN_PHONE=13800138000

# Browser-reachable API origin used in quote download links.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional CDN base for approved catalog images. Leave blank to use the API's
# tenant-scoped /api/store/{slug}/media/{image_id} proxy.
PUBLIC_MEDIA_BASE_URL=

# Text semantic search. Keep secrets in .env or the deployment secret store.
# The OpenAI-compatible adapter calls BASE_URL/v1/embeddings.
TEXT_EMBEDDING_PROFILE=deterministic
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_BASE_URL=
TEXT_EMBEDDING_MODEL=text-embedding-3-large
TEXT_EMBEDDING_MODEL_VERSION=1-d1024
TEXT_EMBEDDING_DIMENSIONS=1024
TEXT_EMBEDDING_TIMEOUT_SECONDS=20
CATALOG_TRANSLATION_PROFILE=disabled
DEEPLX_TRANSLATE_URL=
DEEPLX_TIMEOUT_SECONDS=20
OPENAI_TRANSLATION_BASE_URL=
OPENAI_TRANSLATION_API_KEY=
OPENAI_TRANSLATION_MODEL=
OPENAI_TRANSLATION_TIMEOUT_SECONDS=20
OPENAI_TRANSLATION_MAX_TOKENS=16384
OPENAI_TRANSLATION_REASONING_EFFORT=low
# AI customer-support generation. These values are an environment fallback;
# platform administrators can manage the same provider in Configuration Center.
SUPPORT_AI_ENABLED=false
SUPPORT_AI_BASE_URL=
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=
SUPPORT_AI_MODEL_DISPLAY_NAME=
SUPPORT_AI_TIMEOUT_SECONDS=45
SUPPORT_AI_MAX_OUTPUT_TOKENS=2048
SUPPORT_AI_TEMPERATURE=0.1
SUPPORT_AI_WORKER_INLINE=true
SUPPORT_AI_STALE_JOB_SECONDS=900
# Alternative: CATALOG_TRANSLATION_PROFILE=aliyun_alimt
ALIYUN_TRANSLATION_ACCESS_KEY_ID=
ALIYUN_TRANSLATION_ACCESS_KEY_SECRET=
ALIYUN_TRANSLATION_REGION_ID=cn-hangzhou
ALIYUN_TRANSLATION_ENDPOINT=mt.cn-hangzhou.aliyuncs.com
ALIYUN_TRANSLATION_TIMEOUT_SECONDS=20
CATALOG_TRANSLATION_BATCH_SIZE=50
CATALOG_TRANSLATION_BATCH_CHARACTERS=10000
PUBLIC_LIVE_TRANSLATION_BATCH_SIZE=48
PUBLIC_LIVE_TRANSLATION_BATCH_CHARACTERS=8000
CATALOG_TRANSLATION_PROVIDER_RETRIES=2
CATALOG_TRANSLATION_RETRY_BASE_SECONDS=2
TRANSLATION_REQUESTS_PER_MINUTE=60

# Versioned storefront language packages. Local development reuses MinIO when
# these are left blank; production can point them at a dedicated Cloudflare R2
# bucket without moving product images.
TRANSLATION_PACKAGE_STORAGE_BACKEND=
TRANSLATION_PACKAGE_BUCKET=
TRANSLATION_PACKAGE_ENDPOINT_URL=
TRANSLATION_PACKAGE_REGION=auto
TRANSLATION_PACKAGE_ACCESS_KEY_ID=
TRANSLATION_PACKAGE_SECRET_ACCESS_KEY=
TRANSLATION_PACKAGE_PUBLIC_BASE_URL=

# Shared media storage, including support floating-action images. Cloudflare R2
# uses its S3-compatible endpoint; these credentials stay server-side.
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Loopback-only host ports
ATC_WEB_PORT=5173
ATC_API_PORT=8000
ATC_POSTGRES_PORT=55432
ATC_REDIS_PORT=56379
ATC_RABBITMQ_PORT=5672
ATC_RABBITMQ_MANAGEMENT_PORT=15672
ATC_MINIO_PORT=59000
ATC_MINIO_CONSOLE_PORT=59001

# Optional image provenance label used by local builds.
ATC_COMMIT_SHA=local
