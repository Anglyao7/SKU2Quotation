{
	email {$CADDY_ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2 h3
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

{$ATC_DOMAIN} {
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests"
	@oidc_callback path /login/callback
	header @oidc_callback Referrer-Policy "no-referrer"
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy atc-frontend:8080
	}

	handle {
		reverse_proxy atc-frontend:8080
	}
}

auth.{$ATC_DOMAIN} {
	import security_headers
	encode zstd gzip

	@management path /admin /admin/* /realms/master /realms/master/* /health /health/* /metrics /metrics/*
	respond @management 404

	@public_keycloak path /realms/atc /realms/atc/* /resources /resources/*
	handle @public_keycloak {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		respond 404
	}
}

import /etc/caddy/sites-enabled/*.caddy
