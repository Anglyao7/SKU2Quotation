# Copy this file to .env.production on the server and set mode 600.
# Never commit .env.production. Generate every hex service secret independently:
#   openssl rand -hex 32
# The Keycloak temporary user password is the one exception; generate a mixed
# value that satisfies its password policy, then keep it single-quoted:
#   printf 'Aa1!%s\n' "$(openssl rand -hex 24)"
#
# `compact` is the supported public-beta profile for a 2 vCPU / 3.4 GiB host.
# Use `standard` only on the larger topology documented in DEPLOYMENT.md.
ATC_DEPLOYMENT_PROFILE=compact

# Edge topology. Keep `caddy` on a normal VM where Compose owns ports 80/443.
# Use `nginx` only when a provider-managed outer Nginx already owns port 80;
# the managed-container deployment wrapper will proxy it to this loopback port.
ATC_EDGE_PROXY=caddy
ATC_NGINX_EDGE_PORT=18080
# Emergency compatibility only for a provider-managed nested Docker daemon
# whose cgroup v2 delegation is broken. Keep false on a correctly isolated host.
ATC_NESTED_DOCKER_DISABLE_RESOURCE_LIMITS=false

# Public DNS (hostnames only; never put a bare IP in ATC_DOMAIN)
ATC_DOMAIN=app.example.com
CADDY_ACME_EMAIL=ops@example.com
ATC_EXPECTED_PUBLIC_IP=203.0.113.10

# Application database roles (use URL-safe hex values)
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ATC_MIGRATION_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ATC_APP_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ATC_AUTH_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ATC_WORKER_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ATC_SCHEDULER_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Internal cache. Compact keeps file objects in a Docker volume and persists
# asynchronous work in PostgreSQL, so it does not run RabbitMQ, MinIO, ClamAV,
# or separate workers.
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ATC_ENABLE_WORKERS=false

# Standard profile only:
# RABBITMQ_USER=atc_runtime
# RABBITMQ_PASSWORD=
# MINIO_ROOT_USER=atc_storage
# MINIO_ROOT_PASSWORD=
# OBJECT_STORAGE_BUCKET=atc-production-files
# OBJECT_STORAGE_REGION=us-east-1

# Application session signing
AUTH_JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
AUTH_TOKEN_PEPPER=REPLACE_WITH_64_HEX_CHARACTERS
EMBEDDING_SETTINGS_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TRANSLATION_SETTINGS_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SUPPORT_AI_SETTINGS_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
RERANK_SETTINGS_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
AUTH_ACCESS_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=604800
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_REFRESH_RETRY_GRACE_SECONDS=5
AUTH_PERMISSION_CACHE_TTL_SECONDS=15
QUERY_CACHE_ENABLED=true
QUERY_CACHE_DASHBOARD_TTL_SECONDS=30
QUERY_CACHE_CATALOG_TTL_SECONDS=30
QUERY_CACHE_INVENTORY_TTL_SECONDS=20
QUERY_CACHE_METADATA_TTL_SECONDS=300

# Storefront analytics. Cloudflare must proxy the domain and have the
# "Add visitor location headers" Managed Transform enabled.
STOREFRONT_ANALYTICS_RAW_IP_RETENTION_DAYS=60
TRUST_CLOUDFLARE_VISITOR_HEADERS=true
STOREFRONT_ANALYTICS_GEOLOCATION_URL=https://ipwho.is/{ip}
STOREFRONT_ANALYTICS_GEO_TIMEOUT_SECONDS=1.5
STOREFRONT_ANALYTICS_GEO_CACHE_SECONDS=86400
STOREFRONT_ANALYTICS_GEO_CACHE_MAX_ENTRIES=8192

# Self-hosted OIDC / Keycloak
OIDC_CLIENT_ID=atc-web
OIDC_CLIENT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
OIDC_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
KEYCLOAK_ADMIN_USERNAME=atc-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# 8-128 characters, at least one ASCII letter and one digit, no whitespace.
KEYCLOAK_INITIAL_USER_PASSWORD='REPLACE_WITH_STRONG_MIXED_INITIAL_PASSWORD'

# SMTP is an explicit compact-beta option. With it disabled, the bootstrap
# admin remains verified and can use direct password login, but password-reset
# and member-verification emails are unavailable. Do not invent SMTP values.
ATC_ENABLE_SMTP=false
# When true, uncomment and provide every real value:
# KEYCLOAK_SMTP_HOST=
# KEYCLOAK_SMTP_PORT=587
# KEYCLOAK_SMTP_FROM=
# KEYCLOAK_SMTP_REPLY_TO=
# KEYCLOAK_SMTP_USERNAME=
# KEYCLOAK_SMTP_PASSWORD=

# Idempotent first organization/tenant/OWNER provisioning. The owner email is
# OIDC_BOOTSTRAP_ADMIN_EMAIL above and becomes active only after verified OIDC login.
BOOTSTRAP_ORGANIZATION_CODE=PRIMARY
BOOTSTRAP_ORGANIZATION_NAME="Primary Organization"
BOOTSTRAP_TENANT_SLUG=primary
BOOTSTRAP_TENANT_NAME="Primary Company"
BOOTSTRAP_OWNER_NAME="Platform Owner"
BOOTSTRAP_PLATFORM_ADMIN=true

# Public legal identity and privacy contact. Replace both values with real,
# reviewable operator information before the first production build.
LEGAL_OPERATOR_NAME="REPLACE_WITH_REGISTERED_OPERATOR_NAME"
PRIVACY_CONTACT_EMAIL=REPLACE_WITH_PRIVACY_CONTACT_EMAIL
PRIVACY_EFFECTIVE_DATE=2026-07-29

# Image search stays explicitly unavailable until a reviewed remote provider is
# installed. Never set deterministic in production.
IMAGE_INTELLIGENCE_PROFILE=disabled

# Text semantic search uses an OpenAI-compatible /v1/embeddings endpoint.
# Keep the real key only in the server's mode-600 .env.production file.
TEXT_EMBEDDING_PROFILE=openai_compatible
TEXT_EMBEDDING_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
TEXT_EMBEDDING_BASE_URL=https://api.example.com
TEXT_EMBEDDING_MODEL=text-embedding-3-large
TEXT_EMBEDDING_MODEL_VERSION=1-d1024
TEXT_EMBEDDING_DIMENSIONS=1024
TEXT_EMBEDDING_TIMEOUT_SECONDS=20
TEXT_EMBEDDING_PROVIDER_RETRIES=3
TEXT_EMBEDDING_RETRY_BASE_SECONDS=1
CATALOG_TRANSLATION_PROFILE=openai_compatible
OPENAI_TRANSLATION_BASE_URL=https://api.example.com
OPENAI_TRANSLATION_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
OPENAI_TRANSLATION_MODEL=REPLACE_WITH_TRANSLATION_MODEL
OPENAI_TRANSLATION_TIMEOUT_SECONDS=20
OPENAI_TRANSLATION_MAX_TOKENS=16384
OPENAI_TRANSLATION_REASONING_EFFORT=low
# OpenAI-compatible generation model used by AI customer support. The platform
# Configuration Center can replace these fallback values with encrypted DB settings.
SUPPORT_AI_ENABLED=true
SUPPORT_AI_BASE_URL=https://api.example.com
SUPPORT_AI_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
SUPPORT_AI_MODEL=REPLACE_WITH_SUPPORT_MODEL
SUPPORT_AI_MODEL_DISPLAY_NAME=REPLACE_WITH_CUSTOMER_VISIBLE_MODEL_NAME
SUPPORT_AI_TIMEOUT_SECONDS=45
SUPPORT_AI_MAX_OUTPUT_TOKENS=2048
SUPPORT_AI_TEMPERATURE=0.1
SUPPORT_AI_WORKER_INLINE=false
SUPPORT_AI_STALE_JOB_SECONDS=900
# Optional Cohere-compatible reranker. Leave blank when Configuration Center owns it.
SUPPORT_AI_RERANK_API_KEY=
SUPPORT_AI_RERANK_BASE_URL=
SUPPORT_AI_RERANK_MODEL=
SUPPORT_AI_RERANK_TIMEOUT_MS=800
SUPPORT_AI_RERANK_MAX_DOCUMENTS=30
# Alibaba Cloud General Edition alternative:
# CATALOG_TRANSLATION_PROFILE=aliyun_alimt
# ALIYUN_TRANSLATION_ACCESS_KEY_ID=REPLACE_WITH_RAM_ACCESS_KEY_ID
# ALIYUN_TRANSLATION_ACCESS_KEY_SECRET=REPLACE_WITH_RAM_ACCESS_KEY_SECRET
# ALIYUN_TRANSLATION_REGION_ID=cn-hangzhou
# ALIYUN_TRANSLATION_ENDPOINT=mt.cn-hangzhou.aliyuncs.com
# ALIYUN_TRANSLATION_TIMEOUT_SECONDS=20
# DeepLX remains supported as an alternative profile:
# DEEPLX_TRANSLATE_URL=REPLACE_WITH_SECRET_DEEPLX_TRANSLATE_URL
# DEEPLX_TIMEOUT_SECONDS=20
CATALOG_TRANSLATION_BATCH_SIZE=50
CATALOG_TRANSLATION_BATCH_CHARACTERS=10000
PUBLIC_LIVE_TRANSLATION_BATCH_SIZE=48
PUBLIC_LIVE_TRANSLATION_BATCH_CHARACTERS=8000

# Immutable catalog language packages in Cloudflare R2. The endpoint format is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com. Use an R2 custom domain for the
# public base URL and configure CORS for the storefront origin.
TRANSLATION_PACKAGE_STORAGE_BACKEND=s3
TRANSLATION_PACKAGE_BUCKET=REPLACE_WITH_R2_BUCKET
TRANSLATION_PACKAGE_ENDPOINT_URL=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
TRANSLATION_PACKAGE_REGION=auto
TRANSLATION_PACKAGE_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
TRANSLATION_PACKAGE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
TRANSLATION_PACKAGE_PUBLIC_BASE_URL=https://REPLACE_WITH_LANGUAGE_CDN_DOMAIN

# Compact automatically manages a dedicated 2 GiB host swap file when total
# swap is below this target. Set false only if the server already has managed
# swap supplied by the cloud image.
ATC_COMPACT_MANAGE_SWAP=true
ATC_COMPACT_SWAP_GIB=2

# Backups stay outside the Git checkout and always include local dumps of the
# application and Keycloak PostgreSQL databases. Encrypted off-server restic is
# an explicit compact-beta option; do not put a fake repository in this file.
ATC_BACKUP_ROOT=/var/backups/ai-trade-cloud
ATC_BACKUP_RETENTION_DAYS=14
ATC_ENABLE_REMOTE_BACKUP=false
# When true, initialize and provide both:
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=

# Optional coexistence bridge. Leave disabled unless an existing `www`
# container is attached to the named external Docker network.
ATC_ENABLE_LEGACY_WWW=false
# ATC_LEGACY_WWW_UPSTREAM=legacy-web:80
# ATC_LEGACY_WWW_NETWORK=shared-edge

# Set true for an upgrade only after reviewing every migration as
# expand/contract and compatible with the currently running release.
ATC_CONFIRMED_EXPAND_CONTRACT=false
